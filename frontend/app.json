{
  "expo": {
    "name": "ResumeLab",
    "slug": "resume-lab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/resumelab_logo.png",
    "scheme": "resumebuilder",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/resumelab_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.codewilson64.resumelab"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1972950748945293~3703804227"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/resumelab_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c926fdbc-e4be-4432-b00e-13b8a2d6efd6"
      }
    },
    "owner": "codewilson64"
  }
}
